rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Subcollection: Invisible Actions (Proposals, Payments)
      match /actions/{actionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(actionId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: Chat History
      match /chats/{chatId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(chatId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Subcollection: UI/UX & State Backups (Snapshots for 1-click restore & anchoring)
      match /snapshots/{snapshotId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(snapshotId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // AWallet Balances & Art Credits (Server-Only Writes, Read restricted to Owner UID)
    match /awalletBalances/{userId} {
      // Clients can only read their own balance; write is strictly denied (Backend Service Account only)
      allow read: if isOwner(userId);
      allow write: if false;
    }
  }
}
