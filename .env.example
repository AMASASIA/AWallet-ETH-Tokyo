# 1inch Developer Portal API Key for Fusion swap routing on Base
ONEINCH_API_KEY=dev_fusion_sandbox_key

# Secret Vault HMAC Key for cryptographic verification
SECRET_VAULT_HMAC_KEY=awallet-secret-vault-dev-hmac-key-2026

# Dev mode signature flag
ALLOW_UNSIGNED_DEV_GRANTS=true

# Google Gemini API Key
GEMINI_API_KEY=

# Pimlico / ERC-4337 Bundler RPC URL for Base Sepolia (84532)
BUNDLER_RPC_URL=https://api.pimlico.io/v2/84532/rpc?apikey=demo

# Ephemeral Session Key Private Key
SESSION_KEY_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Shared secret with Raspberry Pi Pico W hardware tap switch
TAP_DEVICE_SECRET=a-wallet-pico-secret-2026

