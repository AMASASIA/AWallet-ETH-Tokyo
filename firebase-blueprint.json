{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and wallet identity information",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "User Google account email"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar URL"
        },
        "walletAddress": {
          "type": "string",
          "description": "Primary Base EVM Smart Wallet Address"
        },
        "baseName": {
          "type": "string",
          "description": "Registered Basename"
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "Server timestamp of last update"
        }
      },
      "required": ["userId", "email"]
    },
    "InvisibleAction": {
      "title": "InvisibleAction",
      "description": "Autonomous financial proposal managed by Tive ◉AI and Policy Engine",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Action unique identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "tier": {
          "type": "integer",
          "description": "Policy Engine tier level (1 to 5)"
        },
        "desc": {
          "type": "string",
          "description": "Proposal description in Japanese"
        },
        "descEn": {
          "type": "string",
          "description": "Proposal description in English"
        },
        "amount": {
          "type": "string",
          "description": "Formatted amount string"
        },
        "amountLabel": {
          "type": "string",
          "description": "Detailed amount label with fiat and crypto value"
        },
        "destination": {
          "type": "string",
          "description": "Recipient address or registered entity name"
        },
        "reason": {
          "type": "string",
          "description": "Specific intent extracted strictly from user speech"
        },
        "reasonEn": {
          "type": "string",
          "description": "Intent in English"
        },
        "whyApprovalNeeded": {
          "type": "string",
          "description": "Explanation of policy requirement"
        },
        "whyApprovalNeededEn": {
          "type": "string",
          "description": "Explanation in English"
        },
        "status": {
          "type": "string",
          "enum": ["awaiting", "approved_app", "approved_tap", "auto_approved", "cancelled"],
          "description": "Execution status"
        },
        "category": {
          "type": "string",
          "description": "Action category"
        },
        "initiatedBy": {
          "type": "string",
          "description": "Initiator agent or service"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of creation"
        }
      },
      "required": ["id", "userId", "tier", "amount", "status"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Multi-turn chat interaction with Tive ◉AI",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message ID"
        },
        "userId": {
          "type": "string",
          "description": "Sender user UID"
        },
        "sender": {
          "type": "string",
          "enum": ["user", "assistant"],
          "description": "Message sender"
        },
        "content": {
          "type": "string",
          "description": "Message text body"
        },
        "model": {
          "type": "string",
          "description": "Gemini model used"
        },
        "timestamp": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "userId", "sender", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Individual user profile records"
    },
    "/users/{userId}/actions/{actionId}": {
      "schema": { "$ref": "#/entities/InvisibleAction" },
      "description": "Financial proposals and actions per user"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Conversational memory and history with Tive ◉AI"
    }
  }
}
